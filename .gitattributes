# Line endings. Text files are normalized in the repository; the types listed with `lf` are also checked out with
# LF on Windows (Bun, the userscript build and the e2e drivers read them as written), batch files with CRLF.
[attr]lf text eol=lf
[attr]crlf text eol=crlf

* text=auto
.githooks/* lf
LICENSE lf
*.css lf
*.ejs lf
*.gitattributes lf
*.gitignore lf
*.html lf
*.js lf
*.json lf
*.m3u8 lf
*.md lf
*.py lf
*.sh lf
*.toml lf
*.ts lf
*.yml lf
*.bat crlf

# Never converted, diffed or merged as text
*.bmp -text -diff -merge
*.gif -text -diff -merge
*.jpeg -text -diff -merge
*.jpg -text -diff -merge
*.map -text -diff -merge
*.png -text -diff -merge
*.tar.gz -text -diff -merge
*.zip -text -diff -merge
