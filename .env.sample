# Copy to .env (ignored by git) to run `bun cli/publish.ts` locally; CONTRIBUTING.md, "Releases".
# addons.mozilla.org API key: https://addons.mozilla.org/developers/addon/api/key/
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
# Chrome Web Store: the publisher, then a service account's JSON key (one line) or an OAuth client and refresh token
CWS_PUBLISHER_ID=
CWS_SERVICE_ACCOUNT_JSON=
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
